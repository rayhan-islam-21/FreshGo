generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id String @id @default(uuid())
  slug String @unique
  name String 
  description String
  price Float
  finalPrice Float?
  discount Int?
  stock Int?
  unlimited Boolean
  images String[]
  category String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}